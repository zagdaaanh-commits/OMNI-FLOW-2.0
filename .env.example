# =============================================================================
# OmniFlow 2.0 configuration. Copy to .env (never commit .env).
# Real environment variables always override values in this file.
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_ENV=production                 # development | test | production
APP_SECRET_KEY=                    # REQUIRED in production, >= 32 chars: openssl rand -hex 32
PUBLIC_BASE_URL=https://app.example.com
FRONTEND_URL=/                     # where OAuth returns the browser
REQUIRE_AUTH=true                  # true: anonymous API calls get 401 (recommended in production)
ALLOW_TENANT_HEADER=false          # dev-only: trust X-Tenant-ID (ignored in production)
CORS_ALLOW_ORIGINS=*               # comma-separated origins, e.g. https://app.example.com
PORT=7860
WEB_CONCURRENCY=2
LOG_LEVEL=INFO

# --- LLM (OpenAI-compatible; defaults to free Zhipu GLM-4-Flash) --------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
MODEL_NAME=glm-4-flash
VISION_MODEL_NAME=glm-4v-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=1.0
LLM_BACKOFF_MAX_SECONDS=20

# --- Network -------------------------------------------------------------------
# Hong Kong cloud server (production): leave EMPTY for direct outbound traffic.
# Mainland local development: http://127.0.0.1:7890  or  socks5h://127.0.0.1:7891
OUTBOUND_PROXY_URL=
HTTP_TIMEOUT_SECONDS=15
NETWORK_PROBE_TIMEOUT_SECONDS=5
NETWORK_PROBE_EXTRA_URLS=

# --- Meta (Facebook / Instagram) -----------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://app.example.com/auth/facebook/callback
META_OAUTH_SCOPES=pages_show_list,pages_manage_posts,pages_read_engagement,business_management
META_GRAPH_VERSION=v23.0
# Default workspace only (single-merchant mode); tenants connect their own pages via OAuth.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_USER_ACCESS_TOKEN=
META_IG_USER_ID=

# --- Database -------------------------------------------------------------------
# Production: Supabase/PostgreSQL. Append ?sslmode=require for Supabase.
DATABASE_URL=
DB_POOL_MIN=1
DB_POOL_MAX=10
# Development fallback when DATABASE_URL is empty:
DATABASE_PATH=./data/marketing.db

# --- Scheduler / Redis -----------------------------------------------------------
SCHEDULER_MODE=embedded            # embedded (dev) | worker (production, run `python -m app.worker`) | off
SCHEDULER_POLL_SECONDS=15
SCHEDULER_MAX_ATTEMPTS=3
SCHEDULER_MAX_LATE_SECONDS=3600    # posts overdue by more than this are failed, not published late
REDIS_URL=redis://:password@redis:6379/0
REDIS_PASSWORD=

# --- Deployment (scripts/deploy_hk.sh) ---------------------------------------------
DOMAIN=app.example.com
LETSENCRYPT_EMAIL=ops@example.com
