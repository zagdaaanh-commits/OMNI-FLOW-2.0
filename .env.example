# =============================================================================
# OmniFlow 2.0 configuration. Copy to .env (never commit .env).
# Real environment variables always override values in this file.
# =============================================================================

# --- App ---------------------------------------------------------------------
APP_ENV=production                 # development | test | production
APP_SECRET_KEY=                    # REQUIRED in production, >= 32 chars: openssl rand -hex 32
PUBLIC_BASE_URL=https://app.example.com   # where Stripe Checkout sends merchants back
FRONTEND_URL=/                     # where OAuth returns the browser
REQUIRE_AUTH=true                  # true: anonymous API calls get 401 (recommended in production)
ALLOW_TENANT_HEADER=false          # dev-only: trust X-Tenant-ID (ignored in production)
CORS_ALLOW_ORIGINS=*               # comma-separated origins, e.g. https://app.example.com
PORT=8000                          # app port behind nginx (docker-compose.prod.yml, nginx/conf.d/app.conf)
WEB_CONCURRENCY=2
LOG_LEVEL=INFO

# --- LLM (OpenAI-compatible; defaults to free Zhipu GLM-4-Flash) --------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
MODEL_NAME=glm-4-flash
VISION_MODEL_NAME=glm-4v-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=1.0
LLM_BACKOFF_MAX_SECONDS=20

# --- Network -------------------------------------------------------------------
# Hong Kong cloud server (production): leave EMPTY for direct outbound traffic.
# Mainland local development: http://127.0.0.1:7890  or  socks5h://127.0.0.1:7891
OUTBOUND_PROXY_URL=
HTTP_TIMEOUT_SECONDS=15
NETWORK_PROBE_TIMEOUT_SECONDS=5
NETWORK_PROBE_EXTRA_URLS=

# --- Meta (Facebook / Instagram) -----------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://app.example.com/auth/facebook/callback
META_OAUTH_SCOPES=pages_show_list,pages_manage_posts,pages_read_engagement,pages_manage_engagement,pages_manage_metadata,business_management
META_GRAPH_VERSION=v23.0
# Default workspace only (single-merchant mode); tenants connect their own pages via OAuth.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_USER_ACCESS_TOKEN=
META_IG_USER_ID=
# Meta agency fast-track (Meetsocial / YinoLink) application link shown in the 快速开户 modal; empty disables the button.
META_AGENCY_APPLY_URL=
# Meta webhook (comments). Callback URL: https://<domain>/api/meta/webhook, field "feed".
# Required in production; events are verified with META_APP_SECRET (X-Hub-Signature-256).
META_VERIFY_TOKEN=
# Optional: POST each agency (快速开户) application to this http(s) URL, e.g. a CRM or WeCom bot.
LEAD_NOTIFICATION_WEBHOOK=
LEAD_WEBHOOK_TIMEOUT_SECONDS=10

# --- Database -------------------------------------------------------------------
# Production: Supabase/PostgreSQL. Append ?sslmode=require for Supabase.
DATABASE_URL=
DB_POOL_MIN=1
DB_POOL_MAX=10
# Development fallback when DATABASE_URL is empty:
DATABASE_PATH=./data/marketing.db

# --- Plans & billing (no free tier) ------------------------------------------------
# New workspaces get a Pro trial of this many days, then AI generation and channel binding need a paid plan.
SUBSCRIPTION_TRIAL_DAYS=7
# Stripe Checkout: card / Alipay / WeChat Pay. Each payment buys one prepaid period (30 or 365 days, no
# auto-renewal) and is activated by the webhook https://<DOMAIN>/api/billing/webhook (events:
# checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed).
# Server-side secrets. Leave STRIPE_SECRET_KEY empty to use the manual flow below instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Also enable them in Stripe Dashboard -> Settings -> Payment methods; "dashboard" = all methods enabled there.
STRIPE_PAYMENT_METHODS=card,alipay,wechat_pay
# Manual flow (no Stripe): payment links shown after "Upgrade" (e.g. a WeChat Pay / Alipay QR page).
# Upgrade requests are also POSTed to LEAD_NOTIFICATION_WEBHOOK. Activate after payment:
#   python scripts/set_plan.py --email <merchant email> --plan pro|agency --cycle monthly|annual
BILLING_CHECKOUT_URL_PRO_MONTHLY=
BILLING_CHECKOUT_URL_PRO_ANNUAL=
BILLING_CHECKOUT_URL_AGENCY_MONTHLY=
BILLING_CHECKOUT_URL_AGENCY_ANNUAL=

# --- File storage (Supabase Storage) ---------------------------------------------
# Business licenses (private bucket agency-documents) and ad creatives (public bucket ad-creatives).
# Create the buckets + policies once: python scripts/migrate.py --sql scripts/supabase_storage_setup.sql
# Server-side secret: the service-role key bypasses RLS. Never expose it to the browser.
# Leave empty to disable uploads (the 快速开户 form then hides the business-license field).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_TIMEOUT_SECONDS=30
DOCUMENT_SIGNED_URL_TTL_SECONDS=600

# --- Scheduler / Redis -----------------------------------------------------------
SCHEDULER_MODE=embedded            # embedded (dev) | worker (production, run `python -m app.worker`) | off
SCHEDULER_POLL_SECONDS=15
SCHEDULER_MAX_ATTEMPTS=3
SCHEDULER_MAX_LATE_SECONDS=3600    # posts overdue by more than this are failed, not published late
REDIS_URL=redis://:password@redis:6379/0
REDIS_PASSWORD=

# --- Deployment (scripts/deploy_hk.sh) ---------------------------------------------
DOMAIN=app.example.com
LETSENCRYPT_EMAIL=ops@example.com
